{
    "title": "Emacs",
    "rules": [
        {
            "description": "emacs - friendly input method",
            "manipulators": [
                {
                    "from": {
                        "key_code": "spacebar",
                        "modifiers": {
                            "mandatory": [
                                "left_shift"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "spacebar",
                            "modifiers": [
                                "option"
                            ]
                        }
                    ],
                    "type": "basic",
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^org\\.gnu\\.Emacs$"
                            ],
                            "type": "frontmost_application_unless"
                        }
                    ]
                },
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^org\\.gnu\\.Emacs$"
                            ],
                            "type": "frontmost_application_unless"
                        }
                    ],
                    "from": {
                        "key_code": "5",
                        "modifiers": {
                            "mandatory": [
                                "left_shift",
                                "command"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "5",
                            "modifiers": [
                                "left_shift",
                                "caps_lock",
                                "command"
                            ]
                        }
                    ],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "toggle macOS input source with Ctrl+Shift+Space (works inside Emacs and vterm)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "spacebar",
                        "modifiers": {
                            "mandatory": [
                                "control",
                                "shift"
                            ]
                        }
                    },
                    "conditions": [
                        {
                            "type": "input_source_if",
                            "input_sources": [
                                {
                                    "language": "^ko$"
                                }
                            ]
                        }
                    ],
                    "to": [
                        {
                            "select_input_source": {
                                "input_source_id": "^com\\.apple\\.keylayout\\.ABC$"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "spacebar",
                        "modifiers": {
                            "mandatory": [
                                "control",
                                "shift"
                            ]
                        }
                    },
                    "to": [
                        {
                            "select_input_source": {
                                "input_mode_id": "^com\\.apple\\.inputmethod\\.Korean\\.2SetKorean$"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
